{
  "hooks": {
    "Stop": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/scripts/stop-review-hook.mjs\"",
            "statusMessage": "Reviewing turn with Claude...",
            "timeout": 900
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/scripts/session-lifecycle-hook.mjs\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
